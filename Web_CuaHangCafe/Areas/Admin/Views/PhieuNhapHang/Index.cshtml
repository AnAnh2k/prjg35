@using Web_CuaHangCafe.Models
@using X.PagedList.Mvc.Core;
@using X.PagedList;
@model IPagedList<TbPhieuNhapHang>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Quản lý Phiếu nhập hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-dolly me-2"></i>Quản lý Phiếu nhập hàng
        </h1>
        <a asp-action="Nhap" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Thêm mới
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <form asp-action="Search" method="get" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="fas fa-calendar-day text-primary"></i>
                        </span>
                        <input type="date" 
                               name="search" 
                               class="form-control border-start-0 ps-0"
                               placeholder="Tìm theo ngày lập">
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>Tìm kiếm
                    </button>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã Phiếu</th>
                            <th>Ngày lập</th>
                            <th>Quán</th>
                            <th>Nhân viên</th>
                            <th>Nhà cung cấp</th>
                            <th>Tổng tiền</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@item.MaPhieuNhap</td>
                                <td>@item.NgayLap.ToString("dd/MM/yyyy")</td>
                                <td>@(item.MaQuanNavigation?.TenQuan ?? "N/A")</td>
                                <td>@(item.MaNhanVienNavigation?.HoTen ?? "N/A")</td>
                                <td>@(item.MaNhaCungCapNavigation?.TenNhaCungCap ?? "N/A")</td>
                                <td>
                                    @{
                                        var tongTien = item.TbPhieuNhapChiTiets?.Sum(ct => ct.SoLuong * ct.DonGia) ?? 0;
                                    }
                                    @tongTien.ToString("n0") ₫
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" 
                                           asp-route-id="@item.MaPhieuNhap"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" 
                                           asp-route-id="@item.MaPhieuNhap"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" 
                                           asp-route-id="@item.MaPhieuNhap"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), 
        new PagedListRenderOptions {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination justify-content-center" }
        })
    </div>
</div>