@model Web_CuaHangCafe.Models.TbPhieuNhapHang
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết Phiếu nhập hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var total = Model.TbPhieuNhapChiTiets?.Sum(detail => detail.ThanhTien ?? (detail.SoLuong * detail.DonGia)) ?? 0;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-file-invoice me-2"></i>Chi tiết Phiếu nhập hàng
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-primary">Thông tin chung</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Mã phiếu:</dt>
                        <dd class="col-sm-8">@Model.MaPhieuNhap</dd>

                        <dt class="col-sm-4">Ngày lập:</dt>
                        <dd class="col-sm-8">@Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Ghi chú:</dt>
                        <dd class="col-sm-8">@(Model.GhiChu ?? "Không có ghi chú")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Quán:</dt>
                        <dd class="col-sm-8">@Model.MaQuanNavigation?.TenQuan</dd>

                        <dt class="col-sm-4">Nhân viên:</dt>
                        <dd class="col-sm-8">@Model.MaNhanVienNavigation?.HoTen</dd>

                        <dt class="col-sm-4">Nhà cung cấp:</dt>
                        <dd class="col-sm-8">@Model.MaNhaCungCapNavigation?.TenNhaCungCap</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-primary">Danh sách nguyên liệu</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.TbPhieuNhapChiTiets?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Mã NL</th>
                                <th>Tên nguyên liệu</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.TbPhieuNhapChiTiets)
                            {
                                <tr>
                                    <td class="ps-4">@detail.MaNguyenLieu</td>
                                    <td>@detail.MaNguyenLieuNavigation?.TenNguyenLieu</td>
                                    <td>@detail.SoLuong</td>
                                    <td>@detail.DonGia.ToString("n0") ₫</td>
                                    <td>@((detail.SoLuong * detail.DonGia).ToString("n0")) ₫</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-group-divider">
                            <tr>
                                <td colspan="4" class="text-end fw-bold ps-4">Tổng cộng:</td>
                                <td class="fw-bold">@total.ToString("n0")) ₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info m-3">Không có chi tiết phiếu nhập</div>
            }
        </div>
    </div>
</div>