@model Web_CuaHangCafe.Models.TbNhanVien
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-user-circle me-2"></i>Chi tiết nhân viên
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs mb-4" id="detailsTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" 
                           id="info-tab" 
                           data-bs-toggle="tab" 
                           data-bs-target="#info" 
                           type="button" 
                           role="tab" 
                           aria-controls="info" 
                           aria-selected="true">
                        <i class="fas fa-info-circle me-2"></i>Thông tin
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" 
                           id="account-tab" 
                           data-bs-toggle="tab" 
                           data-bs-target="#account" 
                           type="button" 
                           role="tab" 
                           aria-controls="account" 
                           aria-selected="false">
                        <i class="fas fa-user-lock me-2"></i>Tài khoản
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" 
                           id="import-tab" 
                           data-bs-toggle="tab" 
                           data-bs-target="#import" 
                           type="button" 
                           role="tab" 
                           aria-controls="import" 
                           aria-selected="false">
                        <i class="fas fa-dolly me-2"></i>Phiếu nhập
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" 
                           id="orders-tab" 
                           data-bs-toggle="tab" 
                           data-bs-target="#orders" 
                           type="button" 
                           role="tab" 
                           aria-controls="orders" 
                           aria-selected="false">
                        <i class="fas fa-receipt me-2"></i>Hoá đơn
                    </button>
                </li>
            </ul>

            <!-- Tab content -->
            <div class="tab-content">
                <!-- Thông tin chính -->
                <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row g-3">
                                <dt class="col-sm-4 text-muted">Mã nhân viên</dt>
                                <dd class="col-sm-8">@Model.MaNhanVien</dd>

                                <dt class="col-sm-4 text-muted">Tên quán</dt>
                                <dd class="col-sm-8">@Model.MaQuanNavigation?.TenQuan</dd>

                                <dt class="col-sm-4 text-muted">Họ tên</dt>
                                <dd class="col-sm-8">@Model.HoTen</dd>

                                <dt class="col-sm-4 text-muted">Chức vụ</dt>
                                <dd class="col-sm-8">@Model.ChucVu</dd>
                            </dl>
                        </div>
                        
                        <div class="col-md-6">
                            <dl class="row g-3">
                                <dt class="col-sm-4 text-muted">Ngày sinh</dt>
                                <dd class="col-sm-8">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-4 text-muted">Giới tính</dt>
                                <dd class="col-sm-8">@Model.GioiTinh</dd>

                                <dt class="col-sm-4 text-muted">Điện thoại</dt>
                                <dd class="col-sm-8">@Model.Sdt</dd>

                                <dt class="col-sm-4 text-muted">Email</dt>
                                <dd class="col-sm-8">@Model.Email</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Tài khoản -->
                <div class="tab-pane fade" id="account" role="tabpanel" aria-labelledby="account-tab">
                    @if (Model.TbTaiKhoans != null && Model.TbTaiKhoans.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tài khoản</th>
                                        <th>Quyền</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var acc in Model.TbTaiKhoans)
                                    {
                                        <tr>
                                            <td>@acc.TenTaiKhoan</td>
                                            <td>@acc.MaQuyenNavigation?.TenQuyen</td>
                                            <td>
                                                <span class="badge bg-success">Hoạt động</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>Không có tài khoản nào
                        </div>
                    }
                </div>

                <!-- Phiếu nhập -->
                <div class="tab-pane fade" id="import" role="tabpanel" aria-labelledby="import-tab">
                    @if (Model.TbPhieuNhapHangs != null && Model.TbPhieuNhapHangs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã phiếu</th>
                                        <th>Ngày nhập</th>
                                        <th>Nhà cung cấp</th>
                                        <th>Tổng tiền</th>
                                        <th>Chi tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var phieu in Model.TbPhieuNhapHangs)
                                    {
                                        var tongTien = phieu.TbPhieuNhapChiTiets?.Sum(ct => ct.SoLuong * ct.DonGia) ?? 0;
                                        <tr>
                                            <td>@phieu.MaPhieuNhap</td>
                                            <td>@phieu.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@phieu.MaNhaCungCapNavigation?.TenNhaCungCap</td>
                                            <td>@tongTien.ToString("N0") đ</td>
                                            <td>
                                                <a href="javascript:void(0);" 
                                                   class="btn btn-sm btn-outline-primary toggle-details" 
                                                   data-target="#import-details-@phieu.MaPhieuNhap">
                                                    <i class="fas fa-chevron-down"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        <tr class="details-row" id="import-details-@phieu.MaPhieuNhap" style="display: none;">
                                            <td colspan="5">
                                                <div class="ms-4">
                                                    <h6 class="text-muted mb-3">Chi tiết phiếu nhập</h6>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm">
                                                            <thead>
                                                                <tr>
                                                                    <th>Nguyên liệu</th>
                                                                    <th>Số lượng</th>
                                                                    <th>Đơn giá</th>
                                                                    <th>Thành tiền</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var ct in phieu.TbPhieuNhapChiTiets)
                                                                {
                                                                    <tr>
                                                                        <td>@ct.MaNguyenLieuNavigation?.TenNguyenLieu</td>
                                                                        <td>@ct.SoLuong</td>
                                                                        <td>@ct.DonGia.ToString("N0") đ</td>
                                                                        <td>@((ct.SoLuong * ct.DonGia).ToString("N0")) đ</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>Không có phiếu nhập nào
                        </div>
                    }
                </div>

                <!-- Hoá đơn -->
                <div class="tab-pane fade" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                    @if (Model.TbHoaDonBans != null && Model.TbHoaDonBans.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã HD</th>
                                        <th>Ngày bán</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Chi tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hd in Model.TbHoaDonBans)
                                    {
                                        <tr>
                                            <td>@hd.MaHoaDon</td>
                                            <td>@hd.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@hd.TongTien.ToString("N0") đ</td>
                                            <td>
                                                <span class="badge bg-success">@hd.TrangThai</span>
                                            </td>
                                            <td>
                                                <a href="javascript:void(0);" 
                                                   class="btn btn-sm btn-outline-primary toggle-details" 
                                                   data-target="#order-details-@hd.MaHoaDon">
                                                    <i class="fas fa-chevron-down"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        <tr class="details-row" id="order-details-@hd.MaHoaDon" style="display: none;">
                                            <td colspan="5">
                                                <div class="ms-4">
                                                    <h6 class="text-muted mb-3">Chi tiết hoá đơn</h6>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm">
                                                            <thead>
                                                                <tr>
                                                                    <th>Sản phẩm</th>
                                                                    <th>Số lượng</th>
                                                                    <th>Đơn giá</th>
                                                                    <th>Thành tiền</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var ct in hd.TbChiTietHoaDonBans)
                                                                {
                                                                    <tr>
                                                                        <td>@ct.MaSanPhamNavigation?.TenSanPham</td>
                                                                        <td>@ct.SoLuong</td>
                                                                        <td>@ct.DonGia.ToString("N0") đ</td>
                                                                        <td>@ct.ThanhTien?.ToString("N0") đ</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>Không có hoá đơn nào
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.MaNhanVien" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-list me-2"></i>Danh sách
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Xử lý toggle chi tiết
            $('.toggle-details').click(function() {
                const target = $(this).data('target');
                $(target).toggle('fast');
                $(this).find('i').toggleClass('fa-chevron-down fa-chevron-up');
            });

            // Xử lý khi chuyển tab
            $('#detailsTab button').click(function() {
                $('.details-row').hide();
                $('.toggle-details i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            });
        });
    </script>
}