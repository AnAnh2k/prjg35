@using Web_CuaHangCafe.Models
@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<TbChiTietHoaDonBan>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-file-invoice me-2"></i>Chi tiết hóa đơn
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay về
        </a>
    </div>

    @if (Model.Any())
    {
        var invoiceDetail = Model.First();
        var bill = invoiceDetail.MaHoaDonNavigation;
        
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Thông tin chung</h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <dl class="mb-0">
                            <dt>Mã hóa đơn</dt>
                            <dd class="fw-bold text-primary">@bill.MaHoaDon</dd>
                            
                            <dt>Ngày lập</dt>
                            <dd>@bill.NgayLap.ToString("dd/MM/yyyy HH:mm")</dd>
                        </dl>
                    </div>
                    
                    <div class="col-md-4">
                        <dl class="mb-0">
                            <dt>Khách hàng</dt>
                            <dd>@(bill.MaKhachHangNavigation?.TenKhachHang ?? "Khách lẻ")</dd>
                            
                            <dt>SĐT</dt>
                            <dd>@(bill.MaKhachHangNavigation?.SdtkhachHang ?? "N/A")</dd>
                        </dl>
                    </div>
                    
                    <div class="col-md-4">
                        <dl class="mb-0">
                            <dt>Tổng tiền</dt>
                            <dd class="fw-bold">@bill.TongTien.ToString("n0") ₫</dd>
                            
                            <dt>Trạng thái</dt>
                            <dd>
                                <span class="badge @(bill.TrangThai == "Hoàn thành" ? "bg-success" : "bg-warning")">
                                    @bill.TrangThai
                                </span>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Danh sách sản phẩm</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th>Hình ảnh</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">@item.MaSanPhamNavigation?.TenSanPham</td>
                                    <td>
                                        <img src="@Url.Content($"~/img/products/{item.MaSanPhamNavigation?.HinhAnh}")" 
                                             class="img-thumbnail" 
                                             style="width: 60px; height: 60px; object-fit: cover;"
                                             onerror="this.onerror=null;this.src='@Url.Content("~/img/placeholder.png")'">
                                    </td>
                                    <td>@item.DonGia.ToString("n0") ₫</td>
                                    <td>@item.SoLuong</td>
                                    <td class="text-end pe-4 fw-medium">@item.ThanhTien?.ToString("n0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-circle me-2"></i>Không tìm thấy chi tiết hóa đơn
        </div>
    }

    <div class="mt-4">
        @Html.PagedListPager(Model, page => Url.Action("Details", new { page }), 
        new PagedListRenderOptions {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination justify-content-center" }
        })
    </div>
</div>