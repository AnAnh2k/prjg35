@model Web_CuaHangCafe.ViewModels.ThuChiDetailViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết Thu Chi";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-file-invoice-dollar me-2"></i>Chi tiết Thu Chi
        </h1>
        <a asp-action="All" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <!-- Header Info -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="text-primary">Quán @Model.CafeId</h5>
                    <p class="text-muted mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>
                        @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <div class="bg-light p-3 rounded">
                        <h5 class="mb-0">Tổng lãi: 
                            <span class="text-success">
                                @((Model.Invoices.Sum(i => i.TongTien) - 
                                 Model.PhieuNhapHangs.Sum(p => p.TbPhieuNhapChiTiets.Sum(ct => ct.SoLuong * ct.DonGia)) -
                                 Model.Employees.Sum(e => e.LuongCoBan * e.HeSoLuong)).ToString("N0")) đ
                            </span>
                        </h5>
                    </div>
                </div>
            </div>

            <!-- Doanh thu -->
            <div class="mb-5">
                <h5 class="text-primary mb-3">
                    <i class="fas fa-receipt me-2"></i>Hóa đơn bán hàng
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã HD</th>
                                <th>Ngày lập</th>
                                <th class="text-end">Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hd in Model.Invoices)
                            {
                                <tr>
                                    <td>@hd.MaHoaDon</td>
                                    <td>@hd.NgayLap.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@hd.TongTien.ToString("N0") đ</td>
                                    <td>
                                        <span class="badge bg-success">@hd.TrangThai</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Chi phí nhân viên -->
            <div class="mb-5">
                <h5 class="text-primary mb-3">
                    <i class="fas fa-users me-2"></i>Chi phí nhân sự
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã NV</th>
                                <th>Họ tên</th>
                                <th class="text-end">Lương cơ bản</th>
                                <th class="text-end">Hệ số</th>
                                <th class="text-end">Thực nhận</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var nv in Model.Employees)
                            {
                                var luong = nv.LuongCoBan * nv.HeSoLuong;
                                <tr>
                                    <td>@nv.MaNhanVien</td>
                                    <td>@nv.HoTen</td>
                                    <td class="text-end">@nv.LuongCoBan.ToString("N0") đ</td>
                                    <td class="text-end">@nv.HeSoLuong.ToString("N2")</td>
                                    <td class="text-end">@luong.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Chi phí nhập hàng -->
            <div class="mb-4">
                <h5 class="text-primary mb-3">
                    <i class="fas fa-dolly me-2"></i>Chi phí nhập hàng
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã PN</th>
                                <th>Ngày nhập</th>
                                <th>Nhà cung cấp</th>
                                <th class="text-end">Tổng tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pn in Model.PhieuNhapHangs)
                            {
                                var total = pn.TbPhieuNhapChiTiets.Sum(ct => ct.SoLuong * ct.DonGia);
                                <tr>
                                    <td>@pn.MaPhieuNhap</td>
                                    <td>@pn.NgayLap.ToString("dd/MM/yyyy")</td>
                                    <td>@pn.MaNhaCungCapNavigation?.TenNhaCungCap</td>
                                    <td class="text-end">@total.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>