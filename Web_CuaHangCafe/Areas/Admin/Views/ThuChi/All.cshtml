@model Web_CuaHangCafe.ViewModels.AllThuChiViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Quản lý Thu Chi";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-coins me-2"></i>Quản lý Thu Chi
        </h1>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <!-- Filter Section -->
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <form asp-action="All" method="post" class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Từ ngày</label>
                            <input type="date" asp-for="StartDate" 
                                   class="form-control" 
                                   value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Đến ngày</label>
                            <input type="date" asp-for="EndDate" 
                                   class="form-control" 
                                   value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-filter me-2"></i>Lọc
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-md-4 d-flex align-items-center justify-content-end">
                    <a asp-action="All" 
                       class="btn btn-outline-danger w-100">
                        <i class="fas fa-sync me-2"></i>Xem tất cả
                    </a>
                </div>
            </div>

            <!-- Data Table -->
            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>Không tìm thấy dữ liệu
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã quán</th>
                                <th>Tên quán</th>
                                <th class="text-end">Thu</th>
                                <th class="text-end">Chi</th>
                                <th class="text-end">Lãi</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.MaQuan</td>
                                    <td>@item.TenQuan</td>
                                    <td class="text-end">@item.TotalRevenue.ToString("N0") đ</td>
                                    <td class="text-end">@item.TotalImport.ToString("N0") đ</td>
                                    <td class="text-end">
                                        <span class="badge bg-success">@item.Profit.ToString("N0") đ</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="AllDetail" 
                                           asp-route-maQuan="@item.MaQuan"
                                           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                                           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-file-invoice me-2"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>