@section Scripts {
<script>
document.getElementById('createProductForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const form = this;
    const modalEl = document.getElementById('addProductModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    const submitBtn = form.querySelector('button[type="submit"]');
    const spinner = submitBtn.querySelector('.spinner-border');
    const submitText = submitBtn.querySelector('.submit-text');
    
    // Hiển thị loading
    submitText.classList.add('d-none');
    spinner.classList.remove('d-none');
    
    try {
        const formData = new FormData(form);
        const response = await fetch('@Url.Action("Create", "HomeAdmin")', {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value
            }
        });

        const result = await response.json();
        
        if (result.success) {
            // Thêm hàng mới vào bảng
            const newRow = createProductRow(result.product);
            document.querySelector('tbody').insertAdjacentHTML('beforeend', newRow);
            
            alert('Thêm sản phẩm thành công:', result.product);


            // Đóng modal và xử lý backdrop
            if (modal) {
                modal.hide();
                
                const handleHidden = () => {
                    // Xóa backdrop
                    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                    // Reset body style
                    document.body.style.overflow = 'visible';
                    document.body.style.paddingRight = '';
                    document.body.classList.remove('modal-open');
                    // Gỡ bỏ sự kiện
                    modalEl.removeEventListener('hidden.bs.modal', handleHidden);
                };
                
                modalEl.addEventListener('hidden.bs.modal', handleHidden);
            }
            
            // Reset form
            form.reset();
            // Reset validation
            $('#createProductForm').validate().resetForm();
            
           
        } else {
            // Hiển thị thông báo lỗi từ server
            let errorMessage = result.message || 'Có lỗi xảy ra';
            if (result.errors && result.errors.length > 0) {
                errorMessage += ": " + result.errors.join(", ");
            }
            alert(errorMessage, 'danger');
        }
    } catch (error) {
        console.error('Error:', error);
        
    } finally {
        submitText.classList.remove('d-none');
        spinner.classList.add('d-none');
    }
});

function createProductRow(product) {
    return `
    <tr data-product-id="${product.MaSanPham}">
        <td class="ps-4 fw-medium">${product.MaSanPham}</td>
        <td>${product.TenSanPham}</td>
        <td>
            <img src="/img/products/${product.HinhAnh}" 
                 class="img-thumbnail" 
                 style="width:80px;height:80px;object-fit:cover;">
        </td>
        <td><span class="badge bg-info">${product.LoaiSanPham}</span></td>
        <td class="text-danger fw-bold">${product.GiaBan} ₫</td>
        <td class="text-truncate" style="max-width:200px;">${product.GhiChu}</td>
        <td class="text-truncate" style="max-width:200px;">${product.VerifyKey}</td>
        <td class="text-end pe-4">
            <div class="d-inline-flex gap-2">
                <a href="/Admin/HomeAdmin/Details/${product.MaSanPham}" 
                       class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-eye"></i>
                    </a>
                <button class="btn btn-sm btn-outline-primary btn-edit" 
                    data-product-id="${product.MaSanPham}">
                    <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger btn-delete" 
                    data-product-id="${product.MaSanPham}">
                    <i class="fas fa-trash-alt"></i>
                </button>                        
            </div>
        </td>
    </tr>`;
}



// Validation với jQuery
$(document).ready(function() {
    $('#createProductForm').validate({
        rules: {
            TenSanPham: 'required',
            GiaBan: { required: true, number: true },
            MaNhomSp: 'required'
        },
        messages: {
            TenSanPham: 'Vui lòng nhập tên sản phẩm',
            GiaBan: {
                required: 'Vui lòng nhập giá bán',
                number: 'Giá bán phải là số hợp lệ'
            },
            MaNhomSp: 'Vui lòng chọn loại sản phẩm'
        },
        errorElement: 'div',
        errorClass: 'invalid-feedback',
        highlight: function(element) {
            $(element).addClass('is-invalid');
        },
        unhighlight: function(element) {
            $(element).removeClass('is-invalid');
        }
    });
});

function previewImage(event) {
        const input = event.target;
        const preview = document.getElementById('imgPreview');
        const uploadArea = document.getElementById('uploadArea');

        if (input.files && input.files[0]) {
            const reader = new FileReader();

            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                uploadArea.style.display = 'none';
            }

            reader.readAsDataURL(input.files[0]);
        }
    }

    // Currency Formatting
    function formatCurrency(input) {
        input.value = input.value.replace(/\D/g, '');
        if (input.value.length > 0) {
            input.value = parseInt(input.value).toLocaleString('vi-VN');
        }
    }

// Xử lý Delete
document.addEventListener('click', async function(e) {
    const deleteBtn = e.target.closest('.btn-delete');
    if (deleteBtn) {
        e.preventDefault();
        e.stopPropagation();
        
        const productId = deleteBtn.dataset.productId;
        const row = deleteBtn.closest('tr');
        
        if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')) return;

        try {
            // Hiển thị loading
            const originalContent = deleteBtn.innerHTML;
            deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            deleteBtn.disabled = true;

            // Tạo form data
            const formData = new FormData();
            formData.append('id', productId);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            const response = await fetch('@Url.Action("DeleteProduct", "HomeAdmin")', {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json' // Yêu cầu server trả về JSON
                }
            });

            const result = await response.json();
            
            if (result.success) {
                // Xóa hàng khỏi DOM bằng productId từ response
                const rowToRemove = document.querySelector(`tr[data-product-id="${result.productId}"]`);
                if (rowToRemove) {
                    rowToRemove.remove();
                }
                alert('Xóa thành công', 'success');
            } else {
                alert(result.message || 'Xóa thất bại', 'danger');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Lỗi kết nối server', 'danger');
        } finally {
            // Khôi phục trạng thái nút
            if (deleteBtn) {
                deleteBtn.innerHTML = '<i class="fas fa-trash-alt"></i>';
                deleteBtn.disabled = false;
            }
        }
    }
});

// Xử lý mở modal edit và điền dữ liệu
document.addEventListener('click', async function(e) {
    const editBtn = e.target.closest('.btn-edit');
    if (editBtn) {
        e.preventDefault();
        const productId = editBtn.dataset.productId;
        
        try {
            // Hiển thị loading
            editBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            
            // Lấy thông tin sản phẩm
            const response = await fetch(`@Url.Action("Edit", "HomeAdmin")?id=${productId}`);
            const product = await response.json();

            // Điền dữ liệu vào form edit
            fillEditForm(product);
            
            // Mở modal
            const editModal = new bootstrap.Modal(document.getElementById('editProductModal'));
            editModal.show();
            
        } catch (error) {
            console.error('Error:', error);
            alert('Lỗi tải dữ liệu sản phẩm', 'danger');
        } finally {
            editBtn.innerHTML = '<i class="fas fa-edit"></i>';
        }
    }
});

// Hàm điền dữ liệu vào form edit
function fillEditForm(product) {
    document.getElementById('editMaSanPham').value = product.maSanPham;
    document.querySelector('#editProductModal [name="TenSanPham"]').value = product.tenSanPham;
    document.querySelector('#editProductModal [name="GiaBan"]').value = product.giaBan;
    document.querySelector('#editProductModal [name="MaNhomSp"]').value = product.maNhomSp;
    document.querySelector('#editProductModal [name="MoTa"]').value = product.moTa || '';
    document.querySelector('#editProductModal [name="GhiChu"]').value = product.ghiChu || '';
    document.querySelector('#editProductModal [name="VerifyKey"]').value = product.VerifyKey;
    
    // Xử lý ảnh preview
    const imgPreview = document.querySelector('#editProductModal #imgPreview');
    imgPreview.src = `/img/products/${product.hinhAnh}`;
    imgPreview.style.display = 'block';
    document.querySelector('#editProductModal #uploadArea').style.display = 'none';
}

// Xử lý submit form edit
document.getElementById('editProductForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const form = this;
    const modal = bootstrap.Modal.getInstance(document.getElementById('editProductModal'));
    const submitBtn = form.querySelector('button[type="submit"]');
    const spinner = submitBtn.querySelector('.spinner-border');
    const submitText = submitBtn.querySelector('.submit-text');

    // Hiển thị loading
    submitText.classList.add('d-none');
    spinner.classList.remove('d-none');

    try {
        const formData = new FormData(form);
        const response = await fetch('@Url.Action("EditProduct", "HomeAdmin")', {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('#editProductModal [name="__RequestVerificationToken"]').value
            }
        });

        const result = await response.json();
        
        if (result.success) {
            // Cập nhật dòng trong bảng
            updateProductRow(result.product);
            modal.hide();
            alert('Cập nhật thành công!', 'success');
        } else {
            alert(result.message || 'Cập nhật thất bại', 'danger');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Lỗi kết nối server', 'danger');
    } finally {
        submitText.classList.remove('d-none');
        spinner.classList.add('d-none');
    }
});

// Hàm cập nhật dòng sản phẩm
function updateProductRow(product) {
    const row = document.querySelector(`tr[data-product-id="${product.MaSanPham}"]`);
    if (row) {
        row.innerHTML = `
            <td class="ps-4 fw-medium">${product.MaSanPham}</td>
            <td>${product.TenSanPham}</td>
            <td>
                <img src="/img/products/${product.HinhAnh}" 
                     class="img-thumbnail" 
                     style="width:80px;height:80px;object-fit:cover;">
            </td>
            <td><span class="badge bg-info">${product.LoaiSanPham}</span></td>
            <td class="text-danger fw-bold">${product.GiaBan.toLocaleString()} ₫</td>
            <td class="text-truncate" style="max-width:200px;">${product.GhiChu || ''}</td>
            <td class="text-truncate" style="max-width:200px;">${product.VerifyKey}</td>
            <td class="text-end pe-4">
                <div class="d-inline-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary btn-details" 
                        data-product-id="${product.MaSanPham}">
                        <i class="fas fa-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-primary btn-edit" 
                        data-product-id="${product.MaSanPham}">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger btn-delete" 
                        data-product-id="${product.MaSanPham}">
                        <i class="fas fa-trash-alt"></i>
                    </button>                        
                </div>
            </td>`;
    }
}

$(document).ready(function() {
    $('#editProductForm').validate({
        rules: {
            TenSanPham: 'required',
            GiaBan: { required: true, number: true },
            MaNhomSp: 'required'
        },
        messages: {
            TenSanPham: 'Vui lòng nhập tên sản phẩm',
            GiaBan: {
                required: 'Vui lòng nhập giá bán',
                number: 'Giá bán phải là số hợp lệ'
            },
            MaNhomSp: 'Vui lòng chọn loại sản phẩm'
        },
        errorElement: 'div',
        errorClass: 'invalid-feedback',
        highlight: function(element) {
            $(element).addClass('is-invalid');
        },
        unhighlight: function(element) {
            $(element).removeClass('is-invalid');
        }
    });
});

</script>
}