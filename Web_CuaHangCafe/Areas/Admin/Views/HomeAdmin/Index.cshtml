@using Web_CuaHangCafe.Models
@using Web_CuaHangCafe.ViewModels
@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<ProductViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-uppercase text-primary">Quản lý sản phẩm</h1>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal">
        <i class="fas fa-plus-circle me-2"></i>Thêm mới
    </button>

        
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <form asp-action="Search" method="get">
                <div class="input-group">
                    <input type="text" 
                           class="form-control border-end-0" 
                           name="search" 
                           placeholder="Tìm kiếm sản phẩm..."
                           aria-label="Search">
                    <button class="btn btn-outline-secondary bg-light border-start-0" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã SP</th>
                            <th>Tên sản phẩm</th>
                            <th>Hình ảnh</th>
                            <th>Loại SP</th>
                            <th>Giá bán</th>
                            <th>Ghi chú</th>
                            <th>VerifyKey</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-product-id="@item.MaSanPham">
                                <td class="ps-4 fw-medium">@item.MaSanPham</td>
                                <td>@item.TenSanPham</td>
                                <td>
                                    <img src="/img/products/@item.HinhAnh" 
                                        class="img-thumbnail" 
                                        style="width: 80px; height: 80px; object-fit: cover;">
                                </td>
                                <td>
                                    <span class="badge bg-info">@item.LoaiSanPham</span>
                                </td>
                                <td class="text-danger fw-bold">@(item.GiaBan?.ToString("n0")) ₫</td>
                                <td class="text-truncate" style="max-width: 200px;">@item.GhiChu</td>
                                <td class="text-truncate" style="max-width: 200px;">@item.VerifyKey</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" 
                                           asp-route-id="@item.MaSanPham" 
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-primary btn-edit" 
                                                data-product-id="@item.MaSanPham">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger btn-delete" 
                                            data-product-id="@item.MaSanPham">
                                             <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), 
            new PagedListRenderOptions {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                UlElementClasses = new[] { "pagination justify-content-center mb-0" }
            })
        </div>
    </div>
    
</div>
 <div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm sản phẩm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createProductForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-4">
                        <!-- Left Column -->
                        <div class="col-md-8">
                            <div class="row g-3">
                                <!-- Product Name -->
                                <div class="col-12">
                                    <label class="form-label fw-bold">Tên sản phẩm</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-tag"></i>
                                        </span>
                                        <input type="text" name="TenSanPham" class="form-control" 
                                               placeholder="Nhập tên sản phẩm" required>
                                    </div>
                                    <span class="text-danger small" data-valmsg-for="TenSanPham"></span>
                                </div>

                                <!-- Price & Category -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Giá bán</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₫</span>
                                        <input type="number" name="GiaBan" class="form-control" 
                                               placeholder="Nhập giá bán" required>
                                    </div>
                                    <span class="text-danger small" data-valmsg-for="GiaBan"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Loại sản phẩm</label>
                                    <select name="MaNhomSp" class="form-select" required>
                                        <option value="">-- Chọn loại --</option>
                                        @foreach (var group in ViewBag.ProductGroups)
                                        {
                                            <option value="@group.MaNhomSp">@group.TenNhomSp</option>
                                        }
                                    </select>
                                    <span class="text-danger small" data-valmsg-for="MaNhomSp"></span>
                                </div>

                                <!-- Description & Note -->
                                <div class="col-12">
                                    <label class="form-label fw-bold">Mô tả sản phẩm</label>
                                    <textarea name="MoTa" class="form-control" rows="3"
                                              placeholder="Nhập mô tả ngắn"></textarea>
                                    <span class="text-danger small" data-valmsg-for="MoTa"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold">Ghi chú</label>
                                    <textarea name="GhiChu" class="form-control" rows="2"
                                              placeholder="Thông tin bổ sung"></textarea>
                                    <span class="text-danger small" data-valmsg-for="GhiChu"></span>
                                </div>
                           
                                <div class="col-12">
                                    <label class="form-label fw-bold">VerifyKey</label>
                                    <textarea name="VerifyKey" class="form-control" rows="2"
                                              placeholder="Thông tin bổ sung"></textarea>
                                    <span class="text-danger small" data-valmsg-for="VerifyKey"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column - Image Upload -->
                        <div class="col-md-4">
                            <div class="card border-0 bg-light">
                                <div class="card-body text-center">
                                    <!-- Image Preview -->
                                    <div class="image-upload-wrapper">
                                        <img id="imgPreview" class="img-fluid mb-3 rounded-3"
                                             style="max-height: 250px; object-fit: cover; display: none;">

                                        <!-- Upload Box -->
                                        <div id="uploadArea" class="border-2 border-dashed rounded-3 p-4">
                                            <i class="fas fa-image fa-3x text-muted mb-3"></i>
                                            <p class="mb-1 small text-muted">
                                                Kéo thả ảnh hoặc
                                                <span class="text-primary">chọn từ máy</span>
                                            </p>
                                            <input type="file" name="ImageFile" class="form-control d-none" 
                                                   id="HinhAnh" accept="image/*" onchange="previewImage(event)">
                                            <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                                                    onclick="document.getElementById('HinhAnh').click()">
                                                Chọn ảnh
                                            </button>
                                        </div>
                                    </div>
                                    <span class="text-danger small" data-valmsg-for="HinhAnh"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">
                        <span class="submit-text">Lưu</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

