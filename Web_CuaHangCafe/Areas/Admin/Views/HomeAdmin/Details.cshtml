@model Web_CuaHangCafe.ViewModels.ProductViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = ViewBag.name;
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-uppercase text-primary">
            <i class="fas fa-info-circle me-2"></i>Chi tiết sản phẩm
        </h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.MaSanPham" class="btn btn-primary me-2">
                <i class="fas fa-edit me-2"></i>Sửa thông tin
            </a>
            <a asp-action="index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay về
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="card-title mb-0">
                @Model.TenSanPham
                <span class="text-muted fs-6">(Mã SP: @Model.MaSanPham)</span>
            </h5>
        </div>
        
        <div class="card-body">
            <div class="row g-4">
                <!-- Thông tin chính -->
                <div class="col-md-8">
                    <div class="row g-3">
                        <!-- Nhóm thông tin cơ bản -->
                        <div class="col-12">
                            <div class="info-group">
                                <label class="info-label">Loại sản phẩm</label>
                                <div class="info-value">
                                    <span class="badge bg-info">@Model.LoaiSanPham</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-group">
                                <label class="info-label">Giá bán</label>
                                <div class="info-value text-danger fw-bold">
                                    @Model.GiaBan.Value.ToString("n0") ₫
                                </div>
                            </div>
                        </div>

                        <!-- Nhóm mô tả -->
                        <div class="col-12">
                            <div class="info-group">
                                <label class="info-label">Mô tả sản phẩm</label>
                                <div class="info-value text-muted">
                                    @(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)
                                </div>
                            </div>
                        </div>

                        <!-- Nhóm ghi chú -->
                        <div class="col-12">
                            <div class="info-group">
                                <label class="info-label">Ghi chú</label>
                                <div class="info-value text-muted">
                                    @(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú" : Model.GhiChu)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hình ảnh -->
                <div class="col-md-4">
                    <div class="card border-0 bg-light">
                        <div class="card-header bg-white border-bottom">
                            <h6 class="mb-0">Hình ảnh sản phẩm</h6>
                        </div>
                        <div class="card-body text-center">
                            <img src="@Url.Content("../../img/Products/" + Model.HinhAnh)" 
                                 class="img-fluid rounded-3 border" 
                                 alt="Hình ảnh sản phẩm"
                                 style="max-height: 300px; object-fit: contain;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .info-group {
        margin-bottom: 1.5rem;
    }

    .info-label {
        display: block;
        font-size: 0.875rem;
        color: #6c757d;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-size: 1rem;
        color: #212529;
        word-break: break-word;
    }
</style>