@model Web_CuaHangCafe.Models.TbNhaCungCap
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Thêm Nhà cung cấp";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="card mb-4 shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="fas fa-truck me-2"></i>Thêm Nhà Cung Cấp Mới</h3>
        </div>
        
        <div class="card-body">
            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="TenNhaCungCap" class="form-control" placeholder=" " />
                            <label asp-for="TenNhaCungCap" class="form-label"></label>
                            <span asp-validation-for="TenNhaCungCap" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="DiaChi" class="form-control" placeholder=" " />
                            <label asp-for="DiaChi" class="form-label"></label>
                            <span asp-validation-for="DiaChi" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Sdtncc" class="form-control" placeholder=" " />
                            <label asp-for="Sdtncc" class="form-label"></label>
                            <span asp-validation-for="Sdtncc" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Stk" class="form-control" placeholder=" " />
                            <label asp-for="Stk" class="form-label"></label>
                            <span asp-validation-for="Stk" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save me-2"></i>Lưu lại
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        .form-floating {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .form-control {
            border-radius: 0.5rem;
            padding: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
                border-color: #86b7fe;
            }

        .card {
            border-radius: 1rem;
            border: none;
        }

        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
            padding: 1.5rem;
        }

        .btn-success {
            background-color: #198754;
            border-color: #198754;
            min-width: 120px;
        }

        .btn-outline-secondary {
            border-color: #6c757d;
        }
    </style>
}