@using Web_CuaHangCafe.Models
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<TbNguyenLieu>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Quản lý nguyên liệu";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-leaf me-2"></i>Quản lý nguyên liệu
        </h1>
        <div class="d-flex gap-3">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle me-2"></i>Thêm mới
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header py-3">
            <form asp-action="Search" method="get" class="search-form">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fas fa-search text-secondary"></i>
                    </span>
                    <input type="text" 
                           name="search" 
                           class="form-control border-start-0 ps-0" 
                           placeholder="Tìm kiếm nguyên liệu..."
                           style="box-shadow: none!important;">
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã</th>
                            <th>Tên nguyên liệu</th>
                            <th>Số lượng</th>
                            <th>Đơn vị</th>
                            <th>HSD</th>
                            <th>Đơn giá</th>
                            <th>SL tối thiểu</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var nl in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@nl.MaNguyenLieu</td>
                                <td>@nl.TenNguyenLieu</td>
                                <td>@nl.SoLuong.ToString("n0")</td>
                                <td>@nl.DonViTinh</td>
                                <td>@(nl.HanSuDung?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>@nl.DonGia.ToString("n0")</td>
                                <td>@nl.SoLuongToiThieu.ToString("n0")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <button class="btn btn-sm btn-outline-success add-to-cart"
                                                data-id="@nl.MaNguyenLieu"
                                                data-ten="@nl.TenNguyenLieu"
                                                data-dongia="@nl.DonGia">
                                            <i class="fas fa-cart-plus me-1"></i>
                                        </button>
                                        <a asp-action="Edit" 
                                           asp-route-id="@nl.MaNguyenLieu"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" 
                                           asp-route-id="@nl.MaNguyenLieu"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), 
        new PagedListRenderOptions {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination justify-content-center" }
        })
    </div>
</div>

@section Scripts {
    <script>
        // Giỏ nhập hàng
        let cartNhap = JSON.parse(localStorage.getItem("cartNhap")) || [];

        $(".add-to-cart").click(function() {
            const id = $(this).data('id');
            const ten = $(this).data('ten');
            const dongia = parseFloat($(this).data('dongia'));

            const existing = cartNhap.find(item => item.MaNguyenLieu === id);
            if (existing) {
                existing.SoLuongNhap++;
                showToast(`Đã cập nhật số lượng cho ${ten}`);
            } else {
                cartNhap.push({
                    MaNguyenLieu: id,
                    TenNguyenLieu: ten,
                    SoLuongNhap: 1,
                    DonGiaNhap: dongia
                });
                showToast(`Đã thêm ${ten} vào giỏ nhập`);
            }
            
            localStorage.setItem("cartNhap", JSON.stringify(cartNhap));
            updateCartBadge();
        });

        function showToast(message) {
           alert(message); // Tạm thời log ra console
        }
    </script>
}