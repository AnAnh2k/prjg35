@model Web_CuaHangCafe.Models.TbKhachHang
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="card shadow mb-4">
        <!-- Card Header -->
        <div class="card-header bg-gradient-primary text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="m-0"><i class="fas fa-user-circle me-2"></i>@Model.TenKhachHang</h4>
                <a asp-action="Index" class="btn btn-light btn-sm">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body">
            <!-- Navigation Tabs -->
            <ul class="nav nav-pills mb-4" id="detailsTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="info-tab" data-bs-toggle="tab" 
                            data-bs-target="#info" type="button" role="tab"
                            aria-controls="info" aria-selected="true">
                        <i class="fas fa-info-circle me-2"></i>Thông tin
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="account-tab" data-bs-toggle="tab"
                            data-bs-target="#account" type="button" role="tab"
                            aria-controls="account" aria-selected="false">
                        <i class="fas fa-user-lock me-2"></i>Tài khoản
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="invoice-tab" data-bs-toggle="tab"
                            data-bs-target="#invoice" type="button" role="tab"
                            aria-controls="invoice" aria-selected="false">
                        <i class="fas fa-receipt me-2"></i>Giao dịch
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="cart-tab" data-bs-toggle="tab"
                            data-bs-target="#cart" type="button" role="tab"
                            aria-controls="cart" aria-selected="false">
                        <i class="fas fa-shopping-cart me-2"></i>Giỏ hàng
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="detailsTabContent">
                <!-- Thông tin -->
                <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="info-card bg-light p-4 rounded-3">
                                <h5 class="mb-3 text-primary"><i class="fas fa-id-card me-2"></i>Thông tin cơ bản</h5>
                                <dl class="row">
                                    <dt class="col-sm-4">Mã KH</dt>
                                    <dd class="col-sm-8 fw-bold text-primary">#@Model.MaKhachHang</dd>

                                    <dt class="col-sm-4">Họ tên</dt>
                                    <dd class="col-sm-8">@Model.TenKhachHang</dd>

                                    <dt class="col-sm-4">Điện thoại</dt>
                                    <dd class="col-sm-8">@Model.SdtkhachHang</dd>

                                    <dt class="col-sm-4">Địa chỉ</dt>
                                    <dd class="col-sm-8">@Model.DiaChi</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tài khoản -->
                <div class="tab-pane fade" id="account" role="tabpanel" aria-labelledby="account-tab">
                    @if (Model.TbTaiKhoanKhs != null && Model.TbTaiKhoanKhs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Tài khoản</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var acc in Model.TbTaiKhoanKhs)
                                    {
                                        <tr>
                                            <td>@acc.TenTaiKhoan</td>
                                            <td>
                                                <span class="badge bg-success">Hoạt động</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info d-flex align-items-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Không có tài khoản đăng nhập
                        </div>
                    }
                </div>

                <!-- Hóa đơn -->
                <div class="tab-pane fade" id="invoice" role="tabpanel" aria-labelledby="invoice-tab">
                    @if (Model.TbHoaDonBans != null && Model.TbHoaDonBans.Any())
                    {
                        <div class="accordion" id="invoiceAccordion">
                            @foreach (var invoice in Model.TbHoaDonBans)
                            {
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading-@invoice.MaHoaDon">
                                        <button class="accordion-button collapsed" type="button" 
                                                data-bs-toggle="collapse" 
                                                data-bs-target="#collapse-@invoice.MaHoaDon">
                                            <div class="d-flex w-100 justify-content-between">
                                                <div>
                                                    <span class="badge bg-primary me-2">#@invoice.MaHoaDon</span>
                                                    @invoice.NgayLap.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                                <div>
                                                    <span class="me-3">Tổng: @invoice.TongTien.ToString("N0")₫</span>
                                                    <span class="badge bg-success">@invoice.TrangThai</span>
                                                </div>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="collapse-@invoice.MaHoaDon" class="accordion-collapse collapse" 
                                         data-bs-parent="#invoiceAccordion">
                                        <div class="accordion-body">
                                            <div class="table-responsive">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>Sản phẩm</th>
                                                            <th>Số lượng</th>
                                                            <th>Đơn giá</th>
                                                            <th>Thành tiền</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var detail in invoice.TbChiTietHoaDonBans)
                                                        {
                                                            <tr>
                                                                <td>@detail.MaSanPhamNavigation?.TenSanPham</td>
                                                                <td>@detail.SoLuong</td>
                                                                <td>@detail.DonGia.ToString("N0")₫</td>
                                                                <td>@detail.ThanhTien?.ToString("N0")₫</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info d-flex align-items-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Không có lịch sử giao dịch
                        </div>
                    }
                </div>

                <!-- Giỏ hàng -->
                <div class="tab-pane fade" id="cart" role="tabpanel" aria-labelledby="cart-tab">
                    @if (Model.TbGioHangs != null && Model.TbGioHangs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-warning">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Số lượng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cart in Model.TbGioHangs)
                                    {
                                        <tr>
                                            <td>@cart.MaSanPhamNavigation?.TenSanPham</td>
                                            <td>@cart.SoLuong</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info d-flex align-items-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Giỏ hàng trống
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-header {
        background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .nav-pills .nav-link {
        border-radius: 0.5rem;
        margin-right: 0.5rem;
        transition: all 0.3s ease;
    }

    .nav-pills .nav-link.active {
        background: #4b6cb7;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .info-card {
        border-left: 4px solid #4b6cb7;
    }

    .accordion-button {
        background-color: #f8f9fa;
        font-weight: 500;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .badge {
        font-weight: 500;
        padding: 0.5em 0.8em;
    }
</style>

@section Scripts {
    <script>
        // Khởi tạo tooltip
        $(document).ready(function(){
            $('[data-bs-toggle="tooltip"]').tooltip();
        });

        // Tự động scroll đến tab active khi load trang
        document.addEventListener("DOMContentLoaded", function(){
            const activeTab = document.querySelector('.nav-pills .nav-link.active');
            if(activeTab){
                activeTab.scrollIntoView({behavior: "smooth", block: "nearest"});
            }
        });
    </script>
}