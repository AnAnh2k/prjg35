@model Web_CuaHangCafe.Models.TbTinTuc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers



<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-newspaper me-2"></i>Chi tiết tin tức
        </h1>
        @* <a asp-action="Index" class="btn btn-outline-secondary"> *@
        @*     <i class="fas fa-arrow-left me-2"></i>Quay lại *@
        @* </a> *@
        <!-- Nút quay về (định nghĩa để dùng AJAX, sau này xử lý đóng modal) -->
        <button type="button" id="btnBack" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </button>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <!-- Thông tin chi tiết -->
                <div class="col-md-8">
                    <dl class="row g-3">
                        <dt class="col-sm-3 text-muted">Mã tin</dt>
                        <dd class="col-sm-9">@Model.MaTinTuc</dd>

                        <dt class="col-sm-3 text-muted">Tiêu đề</dt>
                        <dd class="col-sm-9 fw-semibold">@Model.TieuDe</dd>

                        <dt class="col-sm-3 text-muted">Ngày đăng</dt>
                        <dd class="col-sm-9">@Model.NgayDang.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3 text-muted">Nội dung</dt>
                        <dd class="col-sm-9 text-justify">@Html.Raw(Model.NoiDung)</dd>
                    </dl>
                </div>

                <!-- Hình ảnh -->
                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light">
                        <dt class="text-muted mb-3">Hình ảnh đính kèm</dt>
                        <img src="@Url.Content("~/img/news/" + Model.HinhAnh)" 
                             class="img-fluid rounded-3 shadow-sm" 
                             alt="@Model.TieuDe"
                             style="max-height: 300px; object-fit: cover;">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        @* <a asp-action="Edit" asp-route-id="@Model.MaTinTuc" class="btn btn-primary"> *@
        @*     <i class="fas fa-edit me-2"></i>Chỉnh sửa *@
        @* </a> *@
        <a asp-action="Edit"
           asp-route-id="@Model.MaTinTuc"
           class="btn btn-sm btn-outline-warning ajax-link">
            <i class="fas fa-edit me-1"></i>Sửa
        </a>
        @* <a asp-action="Index" class="btn btn-outline-secondary"> *@
        @*     <i class="fas fa-list me-2"></i>Danh sách tin *@
        @* </a> *@
    </div>
</div>

<style>
    .text-justify {
        text-align: justify;
        white-space: pre-line;
        line-height: 1.6;
    }
</style>