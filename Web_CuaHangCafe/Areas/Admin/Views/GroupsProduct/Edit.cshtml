@model Web_CuaHangCafe.Models.TbNhomSanPham
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sửa nhóm sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-edit me-2"></i>Chỉnh sửa nhóm sản phẩm
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay về
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="MaNhomSp" />

                <div class="form-floating mb-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="fas fa-tag text-primary"></i>
                        </span>
                        <input asp-for="TenNhomSp" 
                               class="form-control border-start-0 ps-0" 
                               placeholder="Nhập tên nhóm sản phẩm"
                               required>
                    </div>
                    <span asp-validation-for="TenNhomSp" class="text-danger small ms-4"></span>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="fas fa-save me-2"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-floating {
        position: relative;
    }
    
    .input-group-text {
        transition: all 0.3s ease;
    }
    
    .form-control:focus + .input-group-text {
        color: #4f46e5;
    }
    
    .form-label {
        position: absolute;
        top: -12px;
        left: 35px;
        background: white;
        padding: 0 5px;
        color: #6c757d;
        font-size: 0.9em;
    }
</style>