@using Web_CuaHangCafe.Models
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<TbNhomSanPham>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Nhóm sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4 fs-4 text-primary">
            <i class="fas fa-layer-group me-2"></i>Quản lý nhóm sản phẩm
        </h1>
        @* <div class="d-flex gap-2"> *@
        @*     <a asp-action="Create" class="btn btn-primary"> *@
        @*         <i class="fas fa-plus-circle me-2"></i>Thêm mới *@
        @*     </a> *@
        @* </div> *@
        <!-- Button Thêm mới -->
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary ajax-link">
                <i class="fas fa-plus-circle me-2"></i>Thêm mới
            </a>
        </div>

    </div>

    <!-- Search và Alert -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            @* <form asp-action="Search" method="get" class="search-form"> *@
            @*     <div class="input-group"> *@
            @*         <span class="input-group-text bg-transparent border-0"> *@
            @*             <i class="fas fa-search text-secondary"></i> *@
            @*         </span> *@
            @*         <input type="text"  *@
            @*                name="search"  *@
            @*                class="form-control form-control-lg border-0 ps-0"  *@
            @*                placeholder="Tìm kiếm nhóm sản phẩm..." *@
            @*                style="box-shadow: none!important;"> *@
            @*     </div> *@
            @* </form> *@
            <form asp-action="Search" method="get" class="search-form">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0">
                        <i class="fas fa-search text-secondary"></i>
                    </span>
                    <input type="text"
                           name="search"
                           class="form-control form-control-lg border-0 ps-0"
                           placeholder="Tìm kiếm nhóm sản phẩm..."
                           style="box-shadow: none!important;">
                </div>
            </form>

        </div>
    </div>

    <div id="dataListContainer">
    <!-- Data Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã nhóm</th>
                            <th>Tên nhóm sản phẩm</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@item.MaNhomSp</td>
                                <td>@item.TenNhomSp</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        @* <a asp-action="Edit"  *@
                                        @*    asp-route-id="@item.MaNhomSp"  *@
                                        @*    class="btn btn-sm btn-outline-primary"> *@
                                        @*     <i class="fas fa-edit me-1"></i>Sửa *@
                                        @* </a> *@
                                        <a asp-action="Edit"
                                           asp-route-id="@item.MaNhomSp"
                                           class="btn btn-sm btn-outline-primary ajax-link">
                                            <i class="fas fa-edit me-1"></i>Sửa
                                        </a>

                                        @* <a asp-action="Delete"  *@
                                        @*    asp-route-id="@item.MaNhomSp"  *@
                                        @*    class="btn btn-sm btn-outline-danger"> *@
                                        @*     <i class="fas fa-trash-alt me-1"></i>Xóa *@
                                        @* </a> *@
                                            <a asp-action="Delete" asp-route-id="@item.MaNhomSp" class="btn btn-sm btn-outline-danger btn-delete">
                                                <i class="fas fa-trash-alt me-1"></i>Xóa
                                            </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
    <!-- Pagination -->
    <div class="mt-3">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), 
        new PagedListRenderOptions {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination justify-content-center" }
        })
    </div>
</div>

<style>
    .search-form {
        max-width: 400px;
    }
    
    .table {
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 0.15rem 1rem rgba(0, 0, 0, 0.05);
    }
    
    .table thead {
        background: #4f46e5;
        color: white;
    }
    
    .table th {
        border-bottom: none;
        padding: 1rem;
        font-weight: 600;
    }
    
    .table td {
        vertical-align: middle;
        padding: 0.75rem;
        border-color: #f3f4f6;
    }
    
    .table-hover tbody tr:hover {
        background-color: #f8f9fc;
    }
    
    .btn-outline-primary {
        border-color: #4f46e5;
        color: #4f46e5;
    }
    
    .btn-outline-primary:hover {
        background-color: #4f46e5;
        color: white;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

                // Lấy tham chiếu đến modal container, modal content và modal body
        const modalContainer = document.getElementById('modalContainer');
        const modalContent = document.getElementById('modalContent');
        const modalBody = document.getElementById('modalBody');

        // --- Hàm mở Modal và hiển thị HTML nội dung vừa load ---
        function openModal(htmlContent) {
            // Chèn nút đóng và nội dung HTML vào modalContent
            modalContent.innerHTML = `<button id="closeModal" style="position: absolute; top: 10px; right: 10px; background: transparent; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>` + htmlContent;
            modalContainer.style.display = 'flex';
            attachCloseEvent();
        }

        // --- Hàm đóng Modal ---
        function closeModal() {
            modalContainer.style.display = 'none';
            modalContent.innerHTML = `<button id="closeModal" style="position: absolute; top: 10px; right: 10px; background: transparent; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>`;
            attachCloseEvent();
        }

        // --- Gán sự kiện cho nút đóng Modal ---
        function attachCloseEvent() {
            const btn = document.getElementById('closeModal');
            if (btn) {
                btn.addEventListener('click', closeModal);
            }
        }
        attachCloseEvent();

        // Bắt sự kiện submit của form tìm kiếm
        const searchForm = document.querySelector('form.search-form');
        searchForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(searchForm);
            const searchQuery = formData.get("search");
            // Xây dựng URL đến action Search; thay "HomeAdmin" theo controller của bạn.
            const url = `@Url.Action("Search", "GroupsProduct")?search=${encodeURIComponent(searchQuery)}`;
            try {
                const response = await fetch(url, {
                    method: 'GET',
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const html = await response.text();
                // Mở modal và hiển thị nội dung trả về (đây sẽ là Partial _SearchResults.cshtml chứa form)
                openModal(html);
            } catch (error) {
                console.error("Lỗi khi tìm kiếm:", error);
            }
        });

            // --- Hàm làm mới danh sách dữ liệu ---
            // Cách 1: tải toàn bộ trang Index qua AJAX rồi trích xuất phần chứa container "dataListContainer"
            function refreshList() {
                fetch('/Admin/GroupsProduct/Index')
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newDataList = doc.getElementById('dataListContainer');
                        if (newDataList) {
                            document.getElementById('dataListContainer').innerHTML = newDataList.innerHTML;
                        } else {
                            console.error('Không tìm thấy container dataListContainer trong trang mới tải.');
                        }
                    })
                    .catch(error => console.error('Error refreshing list:', error));
            }

            // --- Event Delegation: Xử lý các liên kết thêm/sửa có class "ajax-link" ---
            document.addEventListener('click', function(e) {
                const ajaxLink = e.target.closest('a.ajax-link');
                if (ajaxLink) {
                    e.preventDefault();
                    const url = ajaxLink.href;
                    fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.text())
                    .then(html => {
                        openModal(html);
                    })
                    .catch(error => console.error('Error loading form:', error));
                }
            });

            // --- Event Delegation: Xử lý submit form bên trong modal (thêm/sửa) ---
            document.getElementById('modalContent').addEventListener('submit', function(e) {
                e.preventDefault();
                const form = e.target;
                const formData = new FormData(form);
                const actionUrl = form.getAttribute('action');
                const method = form.getAttribute('method') || 'POST';

                fetch(actionUrl, {
                    method: method,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    alert(data.message);
                    if (data.success) {
                        closeModal();
                        refreshList();
                    }
                })
                .catch(error => console.error('Error submitting form:', error));
            });

            // --- Event Delegation: Xử lý nút Xóa trong container dữ liệu ---
            document.getElementById('dataListContainer').addEventListener('click', function(e) {
                const deleteLink = e.target.closest('a.btn-delete');
                if (deleteLink) {
                    e.preventDefault();
                    if (!confirm('Bạn có chắc chắn muốn xóa?')) return;
                    const url = deleteLink.href;
                    fetch(url, {
                        method: 'GET', // Tham khảo: nếu có thể, chuyển sang POST hoặc DELETE
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        alert(data.message);
                        if (data.success) {
                            refreshList();
                        }
                    })
                    .catch(error => console.error('Error deleting item:', error));
                }
            });

            // --- Event Delegation: Xử lý nút "Quay về" trong modal ---
            // Giả sử trong nội dung form bạn có một nút với id "btnBack"
            document.addEventListener('click', function(e) {
                const backBtn = e.target.closest('button#btnBack');
                if (backBtn) {
                    e.preventDefault();
                    closeModal();
                    // Nếu cần, bạn có thể gọi refreshList() để cập nhật lại danh sách
                    // refreshList();
                }
            });

        });
    </script>


}
