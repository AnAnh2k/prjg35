@model Web_CuaHangCafe.Models.TbNhomSanPham
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form id="frmCreateEdit" asp-action="@ViewBag.FormAction" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    @if (Model.MaNhomSp != 0)
    {
        <!-- Nếu là sửa thì hiển thị input ẩn chứa id -->
        <input type="hidden" asp-for="MaNhomSp" />
    }
    <div class="form-group mb-3">
        <label for="tenNhomSp">Tên nhóm sản phẩm</label>
        <input type="text" asp-for="TenNhomSp" id="tenNhomSp" class="form-control" placeholder="Nhập tên nhóm sản phẩm" required />
        <span asp-validation-for="TenNhomSp" class="text-danger"></span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <button type="button" id="btnBack" class="btn btn-secondary">Quay về</button>
    </div>

</form>

<!-- Nếu cần style đặc biệt cho modal, bạn có thể thêm style inline hoặc qua file CSS -->
