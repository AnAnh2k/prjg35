@model Web_CuaHangCafe.Models.TbTinTuc
<div class="card">
    <div class="card-header">Thêm Tin Tức</div>
    <div class="card-body">
        <form id="createForm">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="TieuDe">Tiêu đề</label>
                <input type="text" class="form-control" id="TieuDe" name="TieuDe" required />
                <span class="text-danger" data-valmsg-for="TieuDe"></span>
            </div>
            <div class="form-group">
                <label for="NoiDung">Nội dung</label>
                <textarea class="form-control" id="NoiDung" name="NoiDung" rows="5" required></textarea>
                <span class="text-danger" data-valmsg-for="NoiDung"></span>
            </div>
            <button type="submit" class="btn btn-primary">Thêm</button>
        </form>
    </div>
</div>
