<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="The Space Coffee">
    <meta name="keywords" content="coffee, cafe">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | THE SPACE COFFEE</title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/favicon.ico" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" type="text/css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />

    <!-- Các thư viện CSS khác -->
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css" type="text/css">
    <link rel="stylesheet" href="~/lib/magnific-popup/dist/magnific-popup.css" type="text/css">
    <link rel="stylesheet" href="~/lib/owl-carousel-2/dist/assets/owl.carousel.min.css" type="text/css">
    <link rel="stylesheet" href="~/lib/owl-carousel-2/dist/assets/owl.theme.default.min.css" type="text/css">
    <link rel="stylesheet" href="~/lib/slick-nav/dist/slicknav.min.css" type="text/css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/style.css" type="text/css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style-additional.css" type="text/css" asp-append-version="true">

    <style>
        /* Menu dropdown mobile ẩn mặc định */
        .mobile-dropdown-menu {
            display: none;
            background: #fff;
            position: fixed;
            top: 60px; /* điều chỉnh theo chiều cao header của bạn */
            right: 0;
            left: 0;
            z-index: 11000;
            border-top: 1px solid #ddd;
        }

            /* Khi có class 'open' thì hiện ra */
            .mobile-dropdown-menu.open {
                display: block;
            }

            /* Cài đặt kiểu cho các mục menu */
            .mobile-dropdown-menu ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .mobile-dropdown-menu li {
                border-bottom: 1px solid #eee;
            }

                .mobile-dropdown-menu li a {
                    display: block;
                    padding: 10px;
                    text-decoration: none;
                    color: #333;
                }

        /* Nút hamburger chỉ hiển thị trên mobile */
        .canvas__open {
            display: none;
            position: fixed;
            top: 15px;
            /* left: 15px; */
            left: 100%; /* Đặt từ trái bằng 50% của màn hình */
            transform: translateX(-120%); /* Dịch lại 50% chiều ngang để căn giữa */
            font-size: 1.8rem;
            z-index: 12000;
            cursor: pointer;
        }

        @@media (max-width:1000px) {
            .canvas__open

        {
            display: block;
        }

        }
    </style>
</head>
<body>
    <!-- Page Preloader -->
    <partial name="_PreloaderPartial" />

    <!-- Header Section -->
    <partial name="_HeaderPartial" />

    <!-- Main Body -->
    @RenderBody()

    <!-- Instagram -->
    <partial name="_InstagramPartial" />

    <!-- Footer Section -->
    <partial name="_FooterPartial" />

    <!-- Search -->
    <partial name="_SearchBoxPartial" />

    <!-- Back to Top -->
    <partial name="_BackToTopPartial" />

    <!-- JavaScript Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/magnific-popup/dist/jquery.magnific-popup.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/lib/mixitup/dist/mixitup.min.js"></script>
    <script src="~/lib/jquery.countdown/jquery.countdown.min.js"></script>
    <script src="~/lib/slick-nav/dist/jquery.slicknav.min.js"></script>
    <script src="~/lib/owl-carousel-2/dist/owl.carousel.min.js"></script>
    <script src="~/lib/jquery.nicescroll/dist/jquery.nicescroll.min.js"></script>

    <!-- Bootstrap Bundle (includes Popper.js) từ CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2LcCE5ZZZcxOc6DeScwEo+G5yE/l1F6qqg1Gjk3t9"
            crossorigin="anonymous"></script>

    <script src="~/lib/fontawesome/js/all.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/main-additional.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Lấy phần tử nút hamburger và menu dropdown
            const canvasOpen = document.querySelector(".canvas__open");
            const mobileMenu = document.querySelector(".mobile-dropdown-menu");

            // Khi click vào nút hamburger: toggle class "open" cho menu dropdown
            canvasOpen.addEventListener("click", function(e) {
                e.stopPropagation(); // Ngăn chặn sự kiện nổi lên
                mobileMenu.classList.toggle("open");
            });

            // Đóng menu dropdown khi click ra bên ngoài menu
            document.addEventListener("click", function(e) {
                if (!mobileMenu.contains(e.target) && !canvasOpen.contains(e.target)) {
                    mobileMenu.classList.remove("open");
                }
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var dropdown = document.getElementById("userDropdown");
            if (dropdown) {
                var toggle = dropdown.querySelector(".dropdown-toggle");
                       toggle.addEventListener("click", function(e) {
            e.preventDefault();
            console.log("Toggle clicked"); // Debug: kiểm tra sự kiện click
            dropdown.classList.toggle("active");
        });

                document.addEventListener("click", function(e) {
                    if (!dropdown.contains(e.target)) {
                        dropdown.classList.remove("active");
                    }
                });
            }
        });
    </script>


</body>
</html>


