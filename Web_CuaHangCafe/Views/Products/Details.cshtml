@{
    ViewData["Title"] = @Html.DisplayFor(model => model.TenSanPham);
    ViewData["Products"] = "active";
    var tenTaiKhoan = Context.Session.GetString("TenTaiKhoan");
    var role = Context.Session.GetString("Role");
}

@model Web_CuaHangCafe.Models.TbSanPham

<!--Breadcrumb Begin-->
<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__links">
                    <a asp-controller="home" asp-action="index">
                        <i class="fas fa-home"></i>
                        Trang chủ
                    </a>
                    <a asp-controller="Products" asp-action="Index">Sản phẩm </a>
                    <span>@Html.DisplayFor(model => model.TenSanPham)</span>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Breadcrumb End-->

<!--Product Details Section Begin-->
<section class="product-details spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="product__details__pic">
                    <div class="product__details__slider__content">
                        <div class="product__details__pic__slider owl-carousel">
                            <img class="product__big__img" src=@Url.Content("../../img/products/" + Model.HinhAnh) alt="">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="product__details__text">
                    <strong>Người dùng:</strong> @tenTaiKhoan &nbsp;&nbsp;
                    <strong>Quyền:</strong> @role
                    <button id="btnShowCookie" class="btn btn-info">Xem thông tin Cookie</button>
                    <h3>@Html.DisplayFor(model => model.TenSanPham)</h3>
                    <div class="product__details__price">@Model.GiaBan.ToString("n0") &#8363;</div>
                    <form id="myForm">
                        <div class="product__details__button">
                            @* <div class="quantity"> *@
                            @*     <span>Số lượng:</span> *@
                            @*     <div class="pro-qty"> *@
                            @*         <input type="number" name="quantity" value="1"> *@
                            @*     </div> *@
                            @* </div> *@
                            @* <button asp-controller="cart" *@
                            @*         asp-action="add" *@
                            @*         asp-route-id="@Model.MaSanPham" *@
                            @*         class="cart-btn" *@
                            @*         type="submit"> *@
                            @*     <span> *@
                            @*         <i class="fa-solid fa-cart-shopping"></i> *@
                            @*     </span> Thêm vào giỏ *@
                            @* </button> *@

                            <button type="submit"
                                    data-product-id="@Model.MaSanPham"
                                    data-quantity="1"
                                    class="btn btn-primary cart-btn add-to-cart">
                                <i class="fa-solid fa-cart-shopping"></i> Thêm vào giỏ
                            </button>
                          
                        </div>
                    </form>
                    <div class="product__details__widget">
                        <ul>
                            <li>
                                <span>Tên sản phẩm:</span>
                                <p>@Html.DisplayFor(model => model.TenSanPham)</p>
                            </li>
                            <li>
                                <span>Quy cách:</span>
                                <p>Chưa có thông tin</p>
                            </li>
                            <li>
                                <span>Thành phần:</span>
                                <p>Chưa có thông tin</p>
                            </li>
                            <li>
                                <span>Hạn sử dụng:</span>
                                <p>Chưa có thông tin</p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="product__details__tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="pill" href="#tabs-1" role="tab">Mô tả</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="pill" href="#tabs-2" role="tab">Thông tin chi tiết</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tabs-1" role="tabpanel">
                            <h6>Mô tả</h6>
                            <p>
                                @Model.MoTa
                            </p>
                        </div>
                        <div class="tab-pane fade" id="tabs-2" role="tabpanel">
                            <h6>Thông tin chi tiết</h6>
                            <p>
                                Chưa có thông tin
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Phần hiển thị danh sách sản phẩm vừa xem -->
@if (ViewBag.RecentProducts != null)
{
    var recentProducts = (List<Web_CuaHangCafe.Models.TbSanPham>)ViewBag.RecentProducts;
    if (recentProducts.Count > 0)
    {
        <section class="recent-products spad">
            <div class="container">
                <h3 class="mb-4">Sản phẩm bạn vừa xem</h3>
                <div class="row">
                    @foreach (var p in recentProducts)
                    {
                        <div class="col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                            <div class="recent-product-item">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.MaSanPham">
                                    <img src="@Url.Content("~/img/products/" + p.HinhAnh)" alt="@p.TenSanPham" class="img-fluid" />
                                    <p class="mt-2 text-center">@p.TenSanPham</p>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}

<!-- Phần hiển thị danh sách người dùng đã xem sản phẩm -->
@if (ViewBag.Viewers != null && ((List<string>)ViewBag.Viewers).Any())
{
    var viewers = (List<string>)ViewBag.Viewers;
    <section class="viewers-section spad">
        <div class="container">
            <h4 class="mb-4">Người dùng đã xem sản phẩm này</h4>
            <ul class="list-inline">
                @foreach (var user in viewers)
                {
                    <li class="list-inline-item badge bg-secondary me-2">
                        @user
                    </li>
                }
            </ul>
        </div>
    </section>
}

<style>
    .recent-products {
        margin-top: 3rem;
        padding: 1rem 0;
        background-color: #f7fafc;
    }

    .recent-product-item {
        border: 1px solid #e2e8f0;
        padding: 0.5rem;
        border-radius: 5px;
        background-color: #fff;
        transition: transform 0.2s ease-in-out;
    }

        .recent-product-item:hover {
            transform: scale(1.05);
        }

        .recent-product-item img {
            width: 100%;
            height: auto;
            object-fit: cover;
        }

        .recent-product-item p {
            font-size: 0.9rem;
        }

    .viewers-section {
        margin-top: 2rem;
        padding: 1rem 0;
        background-color: #f7fafc;
    }

        .viewers-section h4 {
            margin-bottom: 1rem;
        }
</style>

<!--Product Details Section End-->
@Html.AntiForgeryToken()

@section Scripts {
    <script>
                        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.add-to-cart').forEach(el => {
                el.addEventListener('click', function (e) {
                    e.preventDefault();
                    const productId = this.getAttribute('data-product-id');
                    const quantity = parseInt(this.getAttribute('data-quantity')) || 1;
                    addToCart(productId, quantity);
                });
            });
        });

                async function addToCart(productId, quantity) {
            const url = '@Url.Action("Add", "Cart")';
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            const csrfToken = tokenElement ? tokenElement.value : '';

            console.log("Gửi yêu cầu addToCart với:", { productId, quantity, csrfToken });

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({ id: productId, quantity: quantity })
                });

                console.log("HTTP status:", response.status);

                if (!response.ok) {
                    throw new Error(`HTTP error ${response.status}`);
                }

                const data = await response.json();
                console.log("Phản hồi addToCart:", data);
                if (data.success) {
                    const cartTip = document.getElementById('cartTip');
                    if (cartTip) { cartTip.textContent = data.cartCount; }
                    alert(data.message);
                }
                else {
                    alert(data.message);
                }
            } catch (error) {
                console.error("Error adding to cart:", error);
                alert("Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng.");
            }
        }


    </script>
    <script>
        document.getElementById("btnShowCookie").addEventListener("click", function () {
            // Lấy danh sách các cookie dưới dạng mảng [ "key=value", ... ]
            let cookieArr = document.cookie.split("; ");
            let cookieObj = {};

            // Chuyển đổi mảng thành đối tượng
            cookieArr.forEach(function (cookie) {
                let parts = cookie.split("=");
                let key = parts[0];
                let value = parts.slice(1).join("="); // định dạng nếu có dấu "=" trong giá trị
                cookieObj[key] = decodeURIComponent(value);
            });
            // Lấy tên người dùng và role từ session (được inject qua Razor)
        let tenTaiKhoan = '@(Context.Session.GetString("TenTaiKhoan") ?? "")';
        let role = '@(Context.Session.GetString("Role") ?? "")';

            // Hiển thị giá trị của cookie 'lastAccess'

            alert("Thông tin cookie 'lastAccess': " + (cookieObj["lastAccess"] || "Không tồn tại") +
              "\nTên người dùng: " + tenTaiKhoan +
              "\nRole: " + role);
        });
    </script>
}
